# ==============================================================================
# Security — always ignore
# ==============================================================================
*.kubeconfig
admin.conf
*.key
*.crt
*-ca.crt
*-token
secrets.yaml
secret-*.yaml
*.env
.env.local

# ==============================================================================
# Python bytecode — generated, never commit
# ==============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt

# ==============================================================================
# Virtual environments
# ==============================================================================
env/
.venv/
venv/

# ==============================================================================
# OS and IDE noise
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
*.temp
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ==============================================================================
# Jupyter — ignore checkpoints only, not notebooks themselves
# ==============================================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ==============================================================================
# Raw experiment data — ~400 MB of Prometheus CSVs, not practical for git
# ==============================================================================
data/raw/*
!data/raw/extension_tier1/
!data/raw/extension_tier1/**
!data/raw/extension_tier2/
!data/raw/extension_tier2/**
!data/raw/extension_tier3/
!data/raw/extension_tier3/**

# ==============================================================================
# Tier 2 batch runner state — machine-local resume checkpoint, not for git
# ==============================================================================
.tier2_state.json
.tier3_state.json

# ==============================================================================
# Downloaded monitoring stack binaries — not code
# ==============================================================================
tools/prometheus*/
tools/grafana*/
tools/alertmanager*/
tools/*.tar.gz
tools/*.zip

# ==============================================================================
# Logs
# ==============================================================================
logs/
*.log
npm-debug.log*

# ==============================================================================
# Monitoring runtime data
# ==============================================================================
dashboards/data/
prometheus/data/
grafana/data/
k8s/monitoring/*-backup.yaml

# ==============================================================================
# Model checkpoints — ignore intermediate/superseded stages
# Keep: S21, S27, S34, S36 (milestones + ablation baseline + final)
# Keep: LSTM baseline, TimeVAE variants
# Ignore: everything else (superseded stages, ~300 MB total)
# ==============================================================================

# Ignore all model .pt files by default
models/**/*.pt
models/**/*.ckpt
models/**/*.safetensors
models/**/*.pth

# Re-track final model and key milestones
!models/phase4/timegan_s36/**/*.pt
!models/phase4/timegan_s36/**/*.json
!models/phase4/timegan_s36_tier3/**/*.pt
!models/phase4/timegan_s36_tier3/**/*.json
!models/phase4/timegan_s36_tier3_sweep/**/*.pt
!models/phase4/timegan_s36_tier3_sweep/**/*.json
!models/phase4/timegan_s36_tier2/**/*.pt
!models/phase4/timegan_s36_tier2/**/*.json
!models/phase4/timegan_s34/**/*.pt
!models/phase4/timegan_s34/**/*.json
!models/phase4/timegan_s27/**/*.pt
!models/phase4/timegan_s27/**/*.json
!models/phase4/timegan_s21/**/*.pt
!models/phase4/timegan_s21/**/*.json
!models/phase4/lstm/**/*.pt
!models/phase4/lstm/**/*.json
!models/phase4/timevae/**/*.pt
!models/phase4/timevae/**/*.json

# Keep model configs for all stages (tiny JSON/YAML files)
!models/**/*.yaml
!models/**/*.json
!models/**/README.md